# Copy to .env for local development. Every value below is the built-in default,
# so an absent .env runs the same way. Invalid values fail at boot, not lazily.

# Port the API listens on (1-65535).
PORT=8080

# development | production. Controls slog output: text locally, JSON in production.
APP_ENV=development

# Absolute URL allowed by CORS. The Vite dev server's origin.
CORS_ORIGIN=http://localhost:5173

# Maximum accepted request body, in bytes.
MAX_BODY_BYTES=1048576

# How long in-flight requests get to finish after SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT=10s
